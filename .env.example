# ============================================
# QueueLess AI+ — Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# The frontend is 100% backend-agnostic — point it at any Spring Boot server.

# Spring Boot REST API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Optional — enable mock mode when the backend is not running yet.
# When true, services return realistic mock JSON instead of hitting the network.
VITE_USE_MOCKS=true

# Optional — request timeout in milliseconds
VITE_API_TIMEOUT=15000
